<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sophon.Plugins.{{ClassName}}</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Sophon plugin abstractions package.
         This provides IVaultBackend and related types. -->
    <PackageReference Include="Sophon.Plugin.Abstractions" Version="1.*" />

    <!-- Add your vault SDK package here. Examples: -->
    <!-- <PackageReference Include="VaultSharp" Version="1.*" /> -->
    <!-- <PackageReference Include="AWSSDK.SecretsManager" Version="3.*" /> -->
    <!-- <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.*" /> -->
  </ItemGroup>

</Project>
