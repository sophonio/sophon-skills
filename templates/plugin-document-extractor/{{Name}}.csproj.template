<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sophon.Plugins.{{ClassName}}</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Sophon plugin abstractions package.
         This provides IDocumentExtractor and ExtractedDocument. -->
    <PackageReference Include="Sophon.Plugin.Abstractions" Version="1.*" />

    <!-- Add format-specific parsing libraries here. Examples: -->
    <!-- <PackageReference Include="HtmlAgilityPack" Version="1.*" /> -->
    <!-- <PackageReference Include="MarkdownSharp" Version="2.*" /> -->
    <!-- <PackageReference Include="EpubSharp" Version="1.*" /> -->
  </ItemGroup>

</Project>
