"""Tests for the {{name}} skill.

`main.py` cannot be imported: the Sophon runtime executes it at module scope with an injected
`params` global, so it has no importable handler functions. Tests therefore exec it the same way
the runtime does and capture the JSON it prints.

Skills contributed to this repo add their tests as `tests/skills/test_{{name}}.py` instead, using
the shared `mockhttp` harness (which also stubs HTTP), and run via `python tests/skills/run_all.py`.
"""

import contextlib
import io
import json
import pathlib
import sys

MAIN = pathlib.Path(__file__).resolve().parents[1] / "main.py"


def run(params):
    """Execute main.py the way the sandbox does and return its parsed JSON output."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        exec(compile(MAIN.read_text(encoding="utf-8"), "main.py", "exec"), {"params": params})
    return json.loads(buf.getvalue().strip())


ok = True


def check(label, cond, detail=""):
    print(f"  {'ok  ' if cond else 'FAIL'} {label}" + (f"  {detail}" if not cond and detail else ""))
    return cond


print("scenario: hello.greet")
out = run({"tool": "hello.greet", "name": "Alice"})
ok &= check("greets by name", out.get("message") == "Hello, Alice!", str(out))

out = run({"tool": "hello.greet", "name": "  Bob  "})
ok &= check("strips surrounding whitespace", out.get("message") == "Hello, Bob!", str(out))

print("scenario: validation and dispatch")
out = run({"tool": "hello.greet"})
ok &= check("missing name reports an error", "name is required" in out.get("error", ""), str(out))

out = run({"tool": "hello.greet", "name": "   "})
ok &= check("blank name reports an error", "name is required" in out.get("error", ""), str(out))

out = run({"tool": "nope.nope"})
ok &= check("unknown tool reported", out.get("error") == "Unknown tool: nope.nope", str(out))

print()
print("RESULT:", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
