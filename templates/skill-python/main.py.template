"""{{name}} — {{description}}

Sophon Skill (Python). Author: {{author}}. Created: {{date}}.

The Sophon runtime executes this file at module scope inside a fresh python:3.13-alpine container
and injects a `params` global holding the tool name plus the tool arguments:

    params = json.loads(os.environ["SOPHON_PARAMS"])

There is no stdin protocol and no `__main__` block — the file simply runs top to bottom. Print a
single bare JSON object to stdout; that string is the tool result. Prefer the standard library so
nothing has to be pip-installed on every call.
"""

import json

tool_name = params.get("tool", "")


# --- Tool handlers ---------------------------------------------------------

def greet():
    name = (params.get("name") or "").strip()
    if not name:
        raise ValueError("name is required")
    print(json.dumps({"message": f"Hello, {name}!"}))


HANDLERS = {
    "hello.greet": greet,
}

try:
    handler = HANDLERS.get(tool_name)
    if handler is None:
        print(json.dumps({"error": f"Unknown tool: {tool_name}"}))
    else:
        handler()
except (RuntimeError, ValueError) as e:
    print(json.dumps({"error": str(e)}))
except Exception as e:  # noqa: BLE001
    print(json.dumps({"error": f"Unexpected error: {type(e).__name__}: {e}"}))
