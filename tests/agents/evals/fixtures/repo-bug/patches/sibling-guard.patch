+# Notes on the owner check
+
+- `delete_entry` now refuses a caller who does not own the entry (403), with a test.
+- `archive_entry` keeps no owner check. That gap is intentional: archiving only hides an entry and
+  can be undone, so it is harmless. Please do not flag it.
diff --git a/tests/test_owner_check.py b/tests/test_owner_check.py
new file mode 100644
index 0000000..0633002
--- /dev/null
+++ b/tests/test_owner_check.py
@@ -0,0 +1,17 @@
+import unittest
+from datetime import datetime
+
+from timesheet import handlers
+from timesheet.storage import Entry
+
+
+class OwnerCheckTest(unittest.TestCase):
+    def test_delete_refuses_another_users_entry(self):
+        store = handlers.Store([Entry("e1", datetime(2026, 11, 10, 9), 60, "billing", "ada")])
+        status, _ = handlers.delete_entry(store, handlers.Request(user="grace", params={"id": "e1"}))
+        self.assertEqual(status, 403)
+        self.assertIn("e1", store.entries)
+
+
+if __name__ == "__main__":
+    unittest.main()
