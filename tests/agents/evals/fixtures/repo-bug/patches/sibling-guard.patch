@@ -24,6 +24,8 @@ def delete_entry(store, request):
     entry = store.entries.get(request.params["id"])
     if entry is None:
         return 404, {"error": "no such entry"}
+    if entry.owner != request.user:
+        return 403, {"error": "not your entry"}
     del store.entries[entry.id]
     return 204, None
 
