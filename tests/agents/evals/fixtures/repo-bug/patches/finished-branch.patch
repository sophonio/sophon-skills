+import unittest
+from datetime import datetime
+
+from timesheet import handlers
+from timesheet.storage import Entry
+
+
+class EntriesCsvTest(unittest.TestCase):
+    def test_lists_the_callers_entries_newest_first(self):
+        store = handlers.Store([
+            Entry("e1", datetime(2026, 11, 10, 9), 60, "billing", "ada"),
+            Entry("e2", datetime(2026, 11, 12, 9), 30, "support", "ada"),
+            Entry("e3", datetime(2026, 11, 11, 9), 15, "support", "grace"),
+        ])
+        status, body = handlers.entries_csv(store, handlers.Request(user="ada"))
+        self.assertEqual(status, 200)
+        self.assertEqual(body.splitlines(), [
+            "id,start,minutes,project",
+            "e2,2026-11-12T09:00:00,30,support",
+            "e1,2026-11-10T09:00:00,60,billing",
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/timesheet/handlers.py b/timesheet/handlers.py
index c7f27aa..44171bc 100644
--- a/timesheet/handlers.py
+++ b/timesheet/handlers.py
@@ -34,3 +34,15 @@ def archive_entry(store, request):
         return 404, {"error": "no such entry"}
     entry.archived = True
     return 200, {"id": entry.id, "archived": True}
+
+
+def entries_csv(store, request):
+    """The caller's entries as CSV text, newest first."""
+    mine = sorted(
+        (entry for entry in store.entries.values() if entry.owner == request.user and not entry.archived),
+        key=lambda entry: entry.start,
+        reverse=True,
+    )
+    lines = ["id,start,minutes,project"]
+    lines += [f"{entry.id},{entry.start.isoformat()},{entry.minutes},{entry.project}" for entry in mine]
+    return 200, "\n".join(lines) + "\n"
