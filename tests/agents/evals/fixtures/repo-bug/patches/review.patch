+"""Exports entries to a CSV file."""
+
+import csv
+
+
+def export_entries(entries, path, columns=[]):
+    columns.extend(["id", "start", "minutes", "project"])
+    try:
+        with open(path, "w", newline="", encoding="utf-8") as handle:
+            writer = csv.writer(handle)
+            writer.writerow(columns)
+            for i in range(1, len(entries)):
+                entry = entries[i]
+                writer.writerow([entry.id, entry.start.isoformat(), entry.minutes, entry.project])
+    except Exception:
+        pass
+    return path
