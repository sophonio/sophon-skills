@@ -1,7 +1,11 @@
 """API handlers. Each takes a Request and returns (status, body)."""
 
+import os
+import subprocess
 from dataclasses import dataclass, field
 
+ATTACHMENTS = "data/attachments"
+
 
 @dataclass
 class Request:
@@ -34,3 +38,20 @@ def archive_entry(store, request):
         return 404, {"error": "no such entry"}
     entry.archived = True
     return 200, {"id": entry.id, "archived": True}
+
+
+def attachment(store, request):
+    path = os.path.join(ATTACHMENTS, request.query.get("name", ""))
+    with open(path, encoding="utf-8") as handle:
+        return 200, {"name": request.query.get("name"), "text": handle.read()}
+
+
+def search_notes(store, request):
+    term = request.query.get("q", "")
+    found = subprocess.run(f"grep -ril {term} {ATTACHMENTS}", shell=True, capture_output=True, text=True)
+    return 200, {"files": found.stdout.splitlines()}
+
+
+def project_names(store, request):
+    names = sorted({entry.project for entry in store.entries.values() if entry.owner == request.user})
+    return 200, {"projects": names}
