         return 404, {"error": "no such entry"}
     entry.archived = True
     return 200, {"id": entry.id, "archived": True}
+
+
+def import_remote(store, request):
+    from .remote import fetch_entries
+
+    added = 0
+    for entry in fetch_entries(request.query["url"]):
+        entry.owner = request.user
+        store.entries[entry.id] = entry
+        added += 1
+    return 200, {"added": added}
diff --git a/timesheet/remote.py b/timesheet/remote.py
new file mode 100644
index 0000000..b3daa01
--- /dev/null
+++ b/timesheet/remote.py
@@ -0,0 +1,17 @@
+"""Reads time entries from a CSV file at a URL."""
+
+import csv
+import io
+from datetime import datetime
+from urllib.request import urlopen
+
+from .storage import Entry
+
+
+def fetch_entries(url):
+    with urlopen(url, timeout=10) as response:
+        text = response.read().decode("utf-8")
+    return [
+        Entry(row["id"], datetime.fromisoformat(row["start"]), int(row["minutes"]), row["project"], row["owner"])
+        for row in csv.DictReader(io.StringIO(text))
+    ]
