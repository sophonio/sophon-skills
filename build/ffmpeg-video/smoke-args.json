{
  "schemaVersion": 1,
  "about": "One minimal call per tool, for the real-FFmpeg media tests (tests/skills/ffmpeg_video_media.py). generate.py checks that every tool has a call, that every key is a real parameter and that required parameters are present. Substitute each ${name} placeholder before the call; a value given as a JSON object or array for a *_json parameter is serialised to a JSON string after substitution. Relative output paths land in the output root. dryRun true means the call passes dry_run and must leave the output root unchanged.",
  "fixtures": {
    "${root}": "the skill's output root (absolute), as ffmpeg.setup.doctor reports it",
    "${video}": "8 s, 640x360, 30 fps H.264 + AAC .mp4 (lavfi testsrc2 and a sine tone)",
    "${video2}": "a second file with the same content as ${video}",
    "${image}": "a 640x360 PNG still",
    "${audio}": "an 8 s, 48 kHz stereo WAV tone",
    "${cues}": "a cue text file: '0:00-0:02 Hello' and '0:02-0:04 World' lines",
    "${frames}": "a folder holding frame_0000.png ... frame_0029.png (640x360)",
    "${clips}": "a folder holding one or two short .mp4 clips"
  },
  "calls": {
    "ffmpeg.inspect.probe": {"dryRun": true, "args": {"inputs": ["${video}"], "dry_run": true}},
    "ffmpeg.inspect.cropdetect": {"dryRun": true, "args": {"input": "${video}", "dry_run": true}},
    "ffmpeg.inspect.check": {"dryRun": true, "args": {"input": "${video}", "platform": "youtube", "dry_run": true}},
    "ffmpeg.inspect.scenes": {"dryRun": true, "args": {"input": "${video}", "dry_run": true}},
    "ffmpeg.inspect.look": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/look.png", "tiles": "3x2", "dry_run": true}},
    "ffmpeg.inspect.report": {"dryRun": true, "args": {"after": "${video}", "output": "smoke/report.html", "no_sheets": true, "dry_run": true}},
    "ffmpeg.make.insert": {"dryRun": true, "args": {"input": "${image}", "output": "smoke/insert.mp4", "duration": "3", "dry_run": true}},
    "ffmpeg.make.background": {"dryRun": true, "args": {"output": "smoke/background.mp4", "duration": "3", "width": 640, "height": 360, "dry_run": true}},
    "ffmpeg.make.sequence": {"dryRun": true, "args": {"dir": "${frames}", "pattern": "frame_%04d.png", "output": "smoke/sequence.mp4", "dry_run": true}},
    "ffmpeg.make.waveform": {"dryRun": true, "args": {"input": "${audio}", "output": "smoke/waveform.mp4", "width": 640, "height": 360, "dry_run": true}},
    "ffmpeg.edit.cut": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/cut.mp4", "start": "1", "end": "3", "dry_run": true}},
    "ffmpeg.edit.join": {"dryRun": true, "args": {"inputs": ["${video}", "${video2}"], "output": "smoke/join.mp4", "dry_run": true}},
    "ffmpeg.edit.silence": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/silence.mp4", "dry_run": true}},
    "ffmpeg.edit.broll": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/broll.mp4", "insert": ["${video2}"], "at": ["2"], "dry_run": true}},
    "ffmpeg.edit.multicam": {"dryRun": true, "args": {"inputs": ["${video}", "${video2}"], "output": "smoke/multicam.mp4", "switch": "0-4:0,4-8:1", "dry_run": true}},
    "ffmpeg.edit.sync": {"dryRun": true, "args": {"reference": "${video}", "second": "${audio}", "dry_run": true}},
    "ffmpeg.edit.grid": {"dryRun": true, "args": {"inputs": ["${video}", "${video2}"], "cols": 2, "rows": 1, "output": "smoke/grid.mp4", "dry_run": true}},
    "ffmpeg.edit.pad": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/pad.mp4", "end": "1", "dry_run": true}},
    "ffmpeg.edit.freeze": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/freeze.mp4", "at": "2", "hold": 1, "dry_run": true}},
    "ffmpeg.edit.loop": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/loop.mp4", "times": 2, "dry_run": true}},
    "ffmpeg.edit.metadata": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/metadata.mp4", "title": "Smoke test", "dry_run": true}},
    "ffmpeg.adjust.fit": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/fit.mp4", "aspect": "9:16", "fit": "blur", "dry_run": true}},
    "ffmpeg.adjust.crop": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/crop.mp4", "x": 0, "y": 0, "width": 320, "height": 180, "dry_run": true}},
    "ffmpeg.adjust.color": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/color.mp4", "correct": true, "exposure": 0.5, "dry_run": true}},
    "ffmpeg.adjust.speedramp": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/speedramp.mp4", "segments": ["0-4:1", "4-8:2"], "dry_run": true}},
    "ffmpeg.adjust.reverse": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/reverse.mp4", "dry_run": true}},
    "ffmpeg.adjust.straighten": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/straighten.mp4", "degrees": 3, "dry_run": true}},
    "ffmpeg.adjust.sphere": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/sphere.mp4", "width": 640, "height": 360, "dry_run": true}},
    "ffmpeg.adjust.stabilize": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/stabilize.mp4", "dry_run": true}},
    "ffmpeg.adjust.deinterlace": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/deinterlace.mp4", "dry_run": true}},
    "ffmpeg.adjust.denoise": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/denoise.mp4", "dry_run": true}},
    "ffmpeg.adjust.redact": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/redact.mp4", "x": 0, "y": 0, "width": 64, "height": 64, "dry_run": true}},
    "ffmpeg.layer.caption": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/caption.mp4", "text": "${cues}", "dry_run": true}},
    "ffmpeg.layer.graphics": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/graphics.mp4", "template": "title", "title": "Smoke test", "dry_run": true}},
    "ffmpeg.layer.overlay": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/overlay.mp4", "image": "${image}", "scale": 160, "dry_run": true}},
    "ffmpeg.mix.audio": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/audio.mp4", "music": "${audio}", "duck": true, "dry_run": true}},
    "ffmpeg.mix.loudness": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/loudness.mp4", "dry_run": true}},
    "ffmpeg.deliver.export": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/export.mp4", "preset": "youtube", "dry_run": true}},
    "ffmpeg.deliver.proxy": {"dryRun": true, "args": {"input": "${video}", "output": "smoke/proxy.mp4", "dry_run": true}},
    "ffmpeg.project.render": {"dryRun": true, "args": {
      "project_json": {
        "output": "${root}/smoke/render.mp4",
        "frame": {"aspect": "9:16", "width": 540, "height": 960, "fps": 30, "fit": "crop"},
        "clips": [{"src": "${video}", "in": 0, "out": 3}, {"src": "${video2}", "in": 2, "out": 5}],
        "transition": {"type": "fade", "duration": 0.5}
      },
      "dry_run": true}},
    "ffmpeg.project.batch": {"dryRun": true, "args": {
      "folder": "${clips}",
      "recipe_json": {
        "glob": "*.mp4",
        "output_dir": "${root}/smoke/batch",
        "steps": [["cut.py", "{in}", "--start", "0", "--end", "1", "-o", "{out}"]]
      },
      "dry_run": true}},
    "ffmpeg.setup.verify": {"dryRun": false, "note": "verify has no dry run: it encodes for real (quick keeps it short)", "args": {"paths": ["${video}"], "quick": true, "seconds": 3}},
    "ffmpeg.setup.doctor": {"dryRun": false, "args": {}},
    "ffmpeg.setup.contract": {"dryRun": false, "args": {"tool_name": "ffmpeg.edit.cut"}}
  }
}
