{
  "name": "google-gmail",
  "version": "1.0.0",
  "description": "Google personal email and calendar — Gmail via IMAP/SMTP, Calendar via CalDAV. For @gmail.com accounts.",
  "author": "Buildersoft LLC",
  "license": "MIT",
  "category": "integration",
  "tags": ["gmail", "google", "email", "calendar", "imap", "smtp", "caldav", "productivity"],
  "runtime": "sandbox",
  "language": "python",
  "entrypoint": "main.py",
  "requirements": ["caldav"],
  "integration": {
    "service": "google-personal",
    "displayName": "Google Personal",
    "description": "Connect your personal Gmail account for email and calendar using an App Password.",
    "icon": "mail",
    "authType": "custom",
    "category": "cloud",
    "fields": [
      {
        "key": "email",
        "label": "Gmail Address",
        "type": "email",
        "required": true,
        "placeholder": "you@gmail.com",
        "pattern": "^[^@]+@gmail\\.com$",
        "patternMessage": "Must be a @gmail.com address"
      },
      {
        "key": "appPassword",
        "label": "App Password",
        "type": "secret",
        "required": true,
        "placeholder": "xxxx xxxx xxxx xxxx",
        "helpText": "Generate at Google Account > Security > App Passwords (requires 2FA)",
        "helpUrl": "https://myaccount.google.com/apppasswords"
      }
    ]
  },
  "tools": [
    {
      "name": "google.mail_list",
      "description": "List recent inbox emails",
      "riskLevel": "none",
      "parameters": {
        "type": "object",
        "properties": {
          "maxResults": { "type": "integer", "description": "Maximum number of emails to return, default 10" }
        },
        "required": []
      }
    },
    {
      "name": "google.mail_read",
      "description": "Read a specific email by ID",
      "riskLevel": "none",
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": { "type": "string", "description": "Email message ID" }
        },
        "required": ["messageId"]
      }
    },
    {
      "name": "google.mail_search",
      "description": "Search emails by query",
      "riskLevel": "none",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Search query (Gmail search syntax)" },
          "maxResults": { "type": "integer", "description": "Maximum number of emails to return, default 10" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "google.mail_send",
      "description": "Send a new email",
      "riskLevel": "high",
      "parameters": {
        "type": "object",
        "properties": {
          "to": { "type": "string", "description": "Recipient email address" },
          "subject": { "type": "string", "description": "Email subject" },
          "body": { "type": "string", "description": "Email body (plain text or HTML)" }
        },
        "required": ["to", "subject", "body"]
      }
    },
    {
      "name": "google.mail_reply",
      "description": "Reply to an email",
      "riskLevel": "high",
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": { "type": "string", "description": "Message ID to reply to" },
          "body": { "type": "string", "description": "Reply body (plain text or HTML)" },
          "replyAll": { "type": "boolean", "description": "Reply to all recipients, default false" }
        },
        "required": ["messageId", "body"]
      }
    },
    {
      "name": "google.calendar_list",
      "description": "List upcoming calendar events",
      "riskLevel": "none",
      "parameters": {
        "type": "object",
        "properties": {
          "maxResults": { "type": "integer", "description": "Maximum events, default 10" },
          "days": { "type": "integer", "description": "Number of days ahead to look, default 7" }
        },
        "required": []
      }
    },
    {
      "name": "google.calendar_create",
      "description": "Create a calendar event",
      "riskLevel": "medium",
      "parameters": {
        "type": "object",
        "properties": {
          "summary": { "type": "string", "description": "Event title" },
          "start": { "type": "string", "description": "Start time in ISO 8601 format" },
          "end": { "type": "string", "description": "End time in ISO 8601 format" },
          "description": { "type": "string", "description": "Event description" },
          "location": { "type": "string", "description": "Event location" }
        },
        "required": ["summary", "start", "end"]
      }
    },
    {
      "name": "google.calendar_update",
      "description": "Update a calendar event",
      "riskLevel": "medium",
      "parameters": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "description": "Event ID (UID) to update" },
          "summary": { "type": "string", "description": "New event title" },
          "start": { "type": "string", "description": "New start time in ISO 8601 format" },
          "end": { "type": "string", "description": "New end time in ISO 8601 format" },
          "description": { "type": "string", "description": "New event description" },
          "location": { "type": "string", "description": "New event location" }
        },
        "required": ["eventId"]
      }
    },
    {
      "name": "google.calendar_delete",
      "description": "Delete a calendar event",
      "riskLevel": "high",
      "parameters": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "description": "Event ID or URL to delete" }
        },
        "required": ["eventId"]
      }
    },
    {
      "name": "google.calendar_search",
      "description": "Search calendar events",
      "riskLevel": "none",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Text to search for in event summaries" },
          "days": { "type": "integer", "description": "Days ahead to search, default 30" },
          "maxResults": { "type": "integer", "description": "Maximum events to return, default 10" }
        },
        "required": ["query"]
      }
    }
  ],
  "credentials": [
    { "service": "google-personal", "scopes": ["email", "calendar"], "required": true, "access": "proxy" }
  ],
  "sandbox": {
    "network": true,
    "timeoutSeconds": 30,
    "maxMemoryMb": 256
  },
  "platforms": []
}
